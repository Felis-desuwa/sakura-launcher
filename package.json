{
  "name": "sakura-launcher",
  "version": "0.9.2",
  "description": "A local game library manager for offline single-player games",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "magpie:fetch": "node scripts/fetch-magpie.mts",
    "dist": "npm run magpie:fetch && electron-vite build && electron-builder --win --dir",
    "dist:portable": "npm run magpie:fetch && electron-vite build && electron-builder --win portable",
    "dist:setup": "npm run magpie:fetch && electron-vite build && electron-builder --win nsis",
    "dist:all": "npm run magpie:fetch && electron-vite build && electron-builder --win",
    "scan-test": "node scripts/scan-test.mts",
    "sidecar-test": "node scripts/sidecar-test.mts",
    "downloader-test": "node scripts/downloader-test.mts",
    "exe-pick-test": "node scripts/exe-pick-test.mts",
    "diagnose-test": "node scripts/diagnose-test.mts",
    "diagnose-probe": "node scripts/diagnose-probe.mts",
    "tag-test": "node scripts/tag-test.mts",
    "magpie-test": "node scripts/magpie-test.mts",
    "cover-test": "node scripts/cover-test.mts",
    "save-test": "node scripts/save-test.mts",
    "share-test": "node scripts/share-test.mts",
    "share-e2e": "node scripts/share-e2e.mts",
    "translate-test": "node scripts/translate-test.mts"
  },
  "dependencies": {
    "resedit": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.0.0"
  }
}

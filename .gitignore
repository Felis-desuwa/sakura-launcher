node_modules/
dist/
out/
release/
# note: build/ is electron-builder's buildResources dir (it holds the app icon),
# not build output — it is tracked on purpose. Build output goes to release/.
# The contact sheet is a scratch aid for judging the icon at small sizes.
build/icon-preview.png
*.tsbuildinfo
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# The bundled Magpie release. Fetched by `npm run magpie:fetch`, which verifies its
# SHA-256 — see THIRD-PARTY-NOTICES.md. Never committed: what is shipped has to be
# provably the unmodified upstream archive, and a checked-in copy proves nothing.
resources/magpie/

# Local-only config and debug output — never commit personal paths or library data
*.local.json
scripts/scan-test-output.*
scripts/*.local.*
